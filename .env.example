# Database Configuration
DATABASE_URL=postgresql://agent:agent_dev@postgres:5432/appdb
DB_HOST=postgres
DB_PORT=5432
DB_NAME=appdb
DB_USER=agent
DB_PASSWORD=agent_dev

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS Configuration (Frontend integration)
CORS_ORIGINS=["http://localhost:3000", "http://Frontend:3000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Logging
LOG_LEVEL=INFO

# Application
APP_NAME=Construction Project Management API
APP_VERSION=1.0.0
